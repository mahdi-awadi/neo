# Neo's embedder settings (ADR-0066 Decision 5). Tracked, no secrets: the service is loopback-only and its
# key (HISTORY_EMBEDDER_KEY) lives only in /home/neo/.env, written by install.ts.
# Machine-local overrides go in embedder.local.env (untracked), which compose reads after this file.
# Image: text-embeddings-inference, the cpu-1.9 line (the tag resolved to cpu-1.9.4), pulled 2026-10-30,
# pinned by digest. Bump: docker pull ghcr.io/huggingface/text-embeddings-inference:cpu-1.9, then copy the
# RepoDigest here.
NEO_EMBEDDER_IMAGE=ghcr.io/huggingface/text-embeddings-inference@sha256:2538ea1c9640d3763b15af668039d24172d063b42337b0c27796fc2be180c78d
# The model and its Hub commit (https://huggingface.co/api/models/BAAI/bge-m3 -> sha, read 2026-10-30).
# The engine's history.embedder.model / revision must name the same pair, or the adapter refuses vectors.
NEO_EMBEDDER_MODEL=BAAI/bge-m3
NEO_EMBEDDER_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Vector length the model gives; the test embed checks it (history.embedder.dims).
NEO_EMBEDDER_DIMS=1024
# Loopback port; history.embedder.url points here.
NEO_EMBEDDER_PORT=8088
# Hard memory cap (memswap equals it: no swap on top). The verify step sets it to the peak + 25 %.
NEO_EMBEDDER_MEM=4g
# CPU cap, and the inference threads inside (keep them equal so threads do not fight for the cap).
NEO_EMBEDDER_CPUS=3
NEO_EMBEDDER_THREADS=3
NEO_EMBEDDER_PIDS=256
# How long install.ts waits for the first health answer (the first start downloads about 2.3 GB).
NEO_EMBEDDER_START_WAIT_S=1200
