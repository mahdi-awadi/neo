# Neo's shared browser settings (ADR-0032). Tracked, no secrets: the service is loopback-only.
# Machine-local overrides go in browser.local.env (untracked), which compose reads after this file.
# Image pinned by digest (browserless/chromium, pulled 2026-10-10). Bump: pull, then copy the RepoDigest.
NEO_BROWSER_IMAGE=ghcr.io/browserless/chromium@sha256:7baa6a4966cb8e1b0249a50173fdc6ed82e36169031548bf49061f273a583113
NEO_BROWSER_PORT=9222
# Hard memory cap for the whole service (every worker's browser together).
NEO_BROWSER_MEM=3g
# Browsers running at once; more wait in the queue (then get 429).
NEO_BROWSER_CONCURRENT=4
NEO_BROWSER_QUEUED=20
# A session idle longer than this is closed (ms).
NEO_BROWSER_TIMEOUT_MS=600000
