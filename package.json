{
  "name": "neo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal work engine on coding-agent SDKs: give it an order over a channel (Telegram/web); it opens the project as a governed headless worker and streams progress back. The engine contains no AI — it routes, governs, meters, and records.",
  "license": "MIT",
  "author": "Mahdi Awadi",
  "homepage": "https://github.com/mahdi-awadi/neo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdi-awadi/neo.git"
  },
  "bugs": {
    "url": "https://github.com/mahdi-awadi/neo/issues"
  },
  "keywords": [
    "claude",
    "claude-agent-sdk",
    "codex",
    "codex-sdk",
    "agent",
    "automation",
    "telegram-bot",
    "bun",
    "typescript",
    "orchestration"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun run src/daemon.ts",
    "start": "bun run src/daemon.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "memory:bootstrap": "bun run src/engine/memory-bootstrap.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.166.0",
    "grammy": "latest",
    "highlight.js": "11.12.0",
    "i18next": "26.4.2",
    "marked": "18.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "1.63.0",
    "typescript": "latest"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.3",
    "proxy-addr": "^2.0.8",
    "zod": "^4.6.6"
  }
}
