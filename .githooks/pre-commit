#!/usr/bin/env bash
# neo-security: Neo security checks (tools/security, ADR-0024). Recreate with: bun ~/.claude/security/init.ts <repo>
# chained: none
kit="${NEO_SECURITY_KIT:-$HOME/.claude/security}"
repo="$(git rev-parse --show-toplevel)"
if [[ -f "$kit/scan.sh" ]]; then
  bash "$kit/scan.sh" staged "$repo" || exit 1
else
  echo "[security] warn: security kit not installed at $kit — scan skipped" >&2
fi
exit 0
